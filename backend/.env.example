NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/theater-ordering

# Dedicated database used by the automated test suite (wiped between runs).
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/theater-ordering-test

# Base URL baked into generated QR codes. No trailing slash.
APP_BASE_URL=http://localhost:5173

# Comma separated list of allowed origins, or * for any.
CORS_ORIGIN=http://localhost:5173

# Number of cryptographically random bytes per QR hash (16 bytes -> 22 base64url chars).
QR_HASH_BYTES=16

# Optional tuning
MONGODB_MAX_POOL_SIZE=20
JSON_BODY_LIMIT=100kb
BULK_SEAT_MAX=500
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Payments (Phase 2 - MOCK ONLY, no real money moves)
# ---------------------------------------------------------------------------
# Only `mock` is implemented. Switching to `razorpay` later requires adding the
# enum value and a RazorpayPaymentService; it must never silently fall back.
PAYMENT_PROVIDER=mock

# Artificial latency for the mock provider so the demo can show a
# "Processing..." state. Set to 0 to make payment instant.
MOCK_PAYMENT_DELAY_MS=500

# Prefix for the KDS-facing order number, e.g. FM-1042
ORDER_NUMBER_PREFIX=FM
