# The backend API origin. Leave EMPTY for same-origin requests (the production
# setup, and the Vite dev proxy). Set it only when the API lives on another host,
# e.g. https://api.example.com
VITE_API_BASE_URL=

# Optional: target the Vite dev-server proxy at a non-default backend host.
VITE_API_PROXY_TARGET=http://localhost:5000
